# Database
POSTGRES_USER=plagiarism
POSTGRES_PASSWORD=changeme
POSTGRES_DB=plagiarism
DATABASE_URL=postgresql+asyncpg://plagiarism:changeme@postgres:5432/plagiarism
DATABASE_URL_SYNC=postgresql://plagiarism:changeme@postgres:5432/plagiarism

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth
API_SECRET_KEY=change-this-to-a-random-secret-key

# Detection thresholds
TAU_LOW=0.25
TAU_HIGH=0.68
ALPHA=0.6

# Winnowing
WINNOW_K=5
WINNOW_W=4

# FAISS
FAISS_INDEX_PATH=/data/faiss/index.faiss
FAISS_NLIST=256
FAISS_M=48
FAISS_NPROBE=32

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=256
CHUNK_OVERLAP=50

# CPU optimization
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false

# Moodle
MOODLE_URL=http://moodle:8080
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle
MOODLE_DB_NAME=moodle
